# Required only for live, source-backed guide generation.
# Create an NVIDIA API key in the NVIDIA API Catalog (build.nvidia.com).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Optional for persistent generated-guide links on Vercel.
# Without these, guides are saved as JSON under .data/ for local development.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
