# Required only for live, source-backed guide generation.
# Create an API key in the Groq Console (console.groq.com).
GROQ_API_KEY=
# GPT OSS supports Groq browser search and JSON-schema structured output.
GROQ_MODEL=openai/gpt-oss-120b

# Optional for persistent generated-guide links on Vercel.
# Without these, guides are saved as JSON under .data/ for local development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
